# Copy to config.yaml and fill in. config.yaml is git-ignored.
bybit:
  # API key of a unified trading account (UTA) with derivatives (contract)
  # trading permission. The bot trades USDT perpetuals: at start it switches
  # every configured symbol to hedge mode (long and short at once) and sets
  # leverage 1x. Use a dedicated sub-account: the bot treats a symbol's long or
  # short position as the position of its strategy.
  api_key: "YOUR_API_KEY"
  api_secret: "YOUR_API_SECRET"
  # Optional, default https://api.bybit.com. Testnet: https://api-testnet.bybit.com
  # base_url: "https://api-testnet.bybit.com"

# Optional: a message to this chat on every entry and when an entry fails after
# the position is opened. Token from @BotFather; chat_id: write to the bot, then open
# https://api.telegram.org/bot<token>/getUpdates and take message.chat.id.
# telegram:
#   token: "123456:ABC..."
#   chat_id: "123456789"

# Martingale series (see martingale in a strategy) are kept here between
# restarts. Optional, default state.json in the working directory.
# state_file: "state.json"

# One strategy per symbol and direction (a long and a short can run on one
# symbol). Values come from the analyzer output.
strategies:
  - symbol: "SOLUSDT"
    direction: "buy" # buy (long) or sell (short), as analyzer.direction; default buy
    timeframe: "4h" # 1m 3m 5m 15m 30m 1h 2h 4h 6h 12h 1d
    # % of the free USDT balance per trade. A smaller order than Bybit's minimum
    # (5 USDT, or e.g. 0.001 BTC) is raised to it, unless the minimum is more
    # than twice this stake: then the entry is skipped and logged.
    deposit_percent: 5.0
    # Same units as the analyzer: offsets from the entry price in 10^-decimals.
    # decimals 2: take_profit 2000 = entry + 20.00 USDT, stop_loss 1500 = entry - 15.00 USDT
    # (for a short: TP 20.00 below the entry, SL 15.00 above).
    decimals: 2
    take_profit: 2000
    stop_loss: 1500
    # Entry: indicator2 > indicator1 on the last closed candle.
    # coef is the period for sma and the multiplier (analyzer range 0.2-1.5)
    # for ema, dema, tema, temaZero.
    # source: L O C H V LO LC LH OC OH CH LOC LOH LCH OCH
    indicator1:
      type: "sma"
      source: "C"
      coef: 5.0
    indicator2:
      type: "ema"
      source: "C"
      coef: 0.5
    # Optional martingale, same rules as analyzer.martingale: deposit_percent is
    # the first stake of a series; after a stop loss the next buy is
    # base + martingale * series loss / TP return, after a take profit it is the
    # base again. After max_losses stop losses in a row (0 = no limit), or when
    # the balance can not cover the stake, the strategy stops and a Telegram
    # message is sent; remove the strategy's key ("SOLUSDT-L" for the long,
    # "SOLUSDT-S" for the short) from state_file to resume.
    # martingale: 1.2
    # max_losses: 5
