log:
  level: "debug"
  path: "./logs/crypto.log"
  days: 7   # remove old logs after N days
  size: 10   # megabytes

db:
  host: "localhost"
  port: 8123
  user: "user"
  password: "pass"
  database: "default"

http:
  port: 8888
  active: false

analyzer:
  direction: "buy"          # buy или sell: конфиги пар берутся из configs/<direction>/<PAIR>.yaml
  active: true              # запускать перебор стратегий (false — только синк свечей и HTTP API)
  gpu: true
  threads: 7
  pair: "SOLUSDT"
  commission: 0.0007        # за одну сторону сделки: тейкер Bybit 0.055% + ~0.015% на средний фандинг
                            # (ставка в среднем +0.014%/день, сделка держится ~2 дня)
  # minWeightedCoef: 2        # фильтр перебора: взвешенный капитал вырос больше чем в N раз (по умолчанию 2)
  # Мартингейл (можно и в конфиге пары): после SL ставка растёт, чтобы TP вернул убыток серии × martingale
  # martingale: 1.2           # 0 или нет ключа — выключен, каждая сделка на весь капитал
  # depositPercent: 30        # первая сделка серии, % капитала
  # maxLosses: 5              # столько SL подряд — стратегия отбрасывается (0 — без ограничения)
